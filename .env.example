# Grafite environment. Copy to `.env` and fill in. `.env` is gitignored.
# All vars are validated at startup by lib/env.ts — the app fails loudly at boot
# if any required var is missing or malformed.

# Neon Postgres — use the POOLED connection string (Vercel's Neon integration).
DATABASE_URL=

# Vercel Blob read/write token (screenshots & pasted images).
BLOB_READ_WRITE_TOKEN=

# The single login password, as a BCRYPT HASH (never plaintext). Generate with:
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 12))" 'your-password'
AUTH_PASSWORD_HASH=

# JWT signing secret — 32+ random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Timezone for daily-note date resolution. "Today" means today here, not UTC.
TZ=Asia/Dhaka

# Optional daily-note template. Supports {{date:FORMAT}} (date-fns format string).
# Default: "# {{date:YYYY-MM-DD}}\n\n"
DAILY_TEMPLATE=
